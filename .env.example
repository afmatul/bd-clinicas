# Copie a .env y cambie las contraseñas. .env nunca se sube al repositorio.

# --- Contenedores (administradores) ---
POSTGRES_ADMIN_PASSWORD=cambiar-postgres
MYSQL_ROOT_PASSWORD=cambiar-mysql
MONGO_ROOT_PASSWORD=cambiar-mongo
COUCH_ADMIN_PASSWORD=cambiar-couch

# --- Usuarios de la aplicación (mínimos privilegios, sin DELETE) ---
PLATAFORMA_DB_PASSWORD=cambiar-plataforma
HOSPITAL_DB_PASSWORD=cambiar-hospital
PEDIATRICO_DB_PASSWORD=cambiar-pediatrico
LABORATORIO_DB_PASSWORD=cambiar-laboratorio
ODONTOLOGICA_DB_PASSWORD=cambiar-odontologica

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas

PLATAFORMA_DATABASE_URL=postgres://app_plataforma:cambiar-plataforma@localhost:5432/plataforma
HOSPITAL_DATABASE_URL=postgres://app_hospital:cambiar-hospital@localhost:5432/hospital
PEDIATRICO_DATABASE_URL=mysql://app_pediatrico:cambiar-pediatrico@localhost:3306/pediatrico
LABORATORIO_MONGO_URL=mongodb://app_laboratorio:cambiar-laboratorio@localhost:27017/laboratorio?authSource=laboratorio
# CouchDB: `npm run db:seed` usa la URL de administrador para crear la base, el design doc,
# los índices y el usuario app_odontologica; la API corre siempre con el usuario no administrador.
COUCH_ADMIN_URL=http://admin:cambiar-couch@localhost:5984
ODONTOLOGICA_COUCH_URL=http://app_odontologica:cambiar-odontologica@localhost:5984
ODONTOLOGICA_COUCH_DB=odontologica
