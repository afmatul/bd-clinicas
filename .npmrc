# Protección contra ataques a la cadena de suministro (ver README, "Instalar dependencias de forma segura").
# No ejecutar scripts de instalación (preinstall/postinstall) de paquetes de terceros.
# Es la vía que usan los paquetes comprometidos para robar tokens y claves.
ignore-scripts=true
# Guardar versiones exactas en package.json (sin ^ ni ~).
save-exact=true
# Rechazar la instalación si la versión de Node no es la del proyecto.
engine-strict=true
# Fallar npm audit solo por vulnerabilidades altas o críticas.
audit-level=high
fund=false
